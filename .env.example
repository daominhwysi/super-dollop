# Dagshub MLflow credentials (required while dagshub.enabled is true).
MLFLOW_TRACKING_USERNAME=your-dagshub-username
MLFLOW_TRACKING_PASSWORD=your-dagshub-access-token

# Optional MLflow overrides used when Dagshub is disabled in configs/dagshub_config.yaml.
MLFLOW_TRACKING_URI=https://dagshub.com/daominhwysi/my-first-repo
MLFLOW_EXPERIMENT_NAME=vietnamese-sequence-labelling
